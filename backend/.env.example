# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/maize_db

# Security
SECRET_KEY=generate_a_secure_random_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# STUB_SCENARIO allowed values: random, healthy, common_rust, northern_leaf_blight, gray_leaf_spot, drought_stress, heat_stress, waterlogging_risk, nutrient_deficiency, out_of_scope, inconclusive
STUB_SCENARIO=random
# When true, stub sensor output uses the latest stored farm reading when available.
STUB_USE_READINGS=true
